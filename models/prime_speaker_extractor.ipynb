   "source": [
    "# ── CELL 3: Upload your reference voice clip ───────────────────────────────────\n",
    "from google.colab import files\n",
    "\n",
    "print('Upload a WAV/MP3 clip of the target speaker (5–30 seconds is ideal):')\n",
    "uploaded = files.upload()\n",
    "REFERENCE_PATH = list(uploaded.keys())[0]\n",
    "print(f'✅ Reference clip: {REFERENCE_PATH}')"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ── CELL 4: Config — fill these in ────────────────────────────────────────────\n",
    "import os\n",
    "\n",
    "HF_TOKEN = 'hf_YOUR_TOKEN_HERE'   # ← paste your HuggingFace token\n",
    "\n",
    "YOUTUBE_URLS = [\n",
    "    'https://www.youtube.com/watch?v=XXXXXXXXX',   # ← add your URLs\n",
    "    'https://www.youtube.com/watch?v=YYYYYYYYY',\n",
    "]\n",
    "\n",
    "SIMILARITY_THRESHOLD = 0.80   # lower → more permissive, raise → stricter\n",
    "MIN_SEGMENT_MS       = 1500   # skip segments shorter than this (milliseconds)\n",
    "\n",
    "TMP_DIR = '/content/tmp_audio'\n",
    "os.makedirs(TMP_DIR, exist_ok=True)\n",
    "print('✅ Config set')"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ── CELL 5: Load models ────────────────────────────────────────────────────────\n",
    "import torch\n",
    "from pyannote.audio import Pipeline\n",
    "from resemblyzer import VoiceEncoder, preprocess_wav\n",
    "\n",
    "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "print(f'🖥️  Device: {device}')\n",
    "\n",
    "print('Loading diarization pipeline (first run downloads ~1GB)...')\n",
    "diarization_pipeline = Pipeline.from_pretrained(\n",
    "    'pyannote/speaker-diarization-3.1',\n",
    "    use_auth_token=HF_TOKEN\n",
    ").to(device)\n",
    "\n",
    "print('Loading voice encoder...')\n",
    "encoder = VoiceEncoder(device=str(device))\n",
    "\n",
    "print('✅ Models loaded')"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ── CELL 6: Compute reference embedding ───────────────────────────────────────\n",
    "import numpy as np\n",
    "from pydub import AudioSegment\n",
    "import subprocess\n",
    "\n",
    "def to_mono_16k(input_path, output_path):\n",
    "    \"\"\"Convert any audio file to 16kHz mono WAV.\"\"\"\n",
    "    subprocess.run([\n",
    "        'ffmpeg', '-y', '-i', input_path,\n",
    "        '-ar', '16000', '-ac', '1', output_path\n",
    "    ], capture_output=True)\n",
    "\n",
    "def get_embedding(wav_path):\n",
    "    wav = preprocess_wav(wav_path)\n",
    "    return encoder.embed_utterance(wav)\n",
    "\n",
    "def cosine_sim(a, b):\n",
    "    return float(np.dot(a, b) / (np.linalg.norm(a) * np.linalg.norm(b)))\n",
    "\n",
    "# Convert reference to 16kHz mono\n",
    "ref_converted = '/content/reference_16k.wav'\n",
    "to_mono_16k(REFERENCE_PATH, ref_converted)\n",
    "reference_embedding = get_embedding(ref_converted)\n",
    "print('✅ Reference embedding computed')"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ── CELL 7: Helper functions ───────────────────────────────────────────────────\n",
    "from pathlib import Path\n",
    "\n",
    "def download_audio(url, tmp_dir):\n",
    "    \"\"\"Download YouTube audio as 16kHz mono WAV.\"\"\"\n",
    "    template = str(Path(tmp_dir) / '%(title)s.%(ext)s')\n",
    "    cmd = [\n",
    "        'yt-dlp', '--extract-audio', '--audio-format', 'wav',\n",
    "        '--postprocessor-args', '-ar 16000 -ac 1',\n",
    "        '--output', template, '--no-playlist', url\n",
    "    ]\n",
    "    result = subprocess.run(cmd, capture_output=True, text=True)\n",
    "    if result.returncode != 0:\n",
    "        raise RuntimeError(f'yt-dlp error: {result.stderr}')\n",
    "    wav_files = sorted(Path(tmp_dir).glob('*.wav'), key=os.path.getmtime)\n",
    "    return wav_files[-1]\n",
    "\n",
    "\n",
    "def diarize(audio_path):\n",
    "    \"\"\"Run speaker diarization, return list of segment dicts.\"\"\"\n",
    "    result = diarization_pipeline(str(audio_path))\n",
    "    segments = []\n",
    "    for turn, _, speaker in result.itertracks(yield_label=True):\n",
    "        dur_ms = int((turn.end - turn.start) * 1000)\n",
    "        if dur_ms < MIN_SEGMENT_MS:\n",
    "            continue\n",
    "        segments.append({\n",
    "            'speaker': speaker,\n",
    "            'start_ms': int(turn.start * 1000),\n",
    "            'end_ms': int(turn.end * 1000),\n",
    "        })\n",
    "    return segments\n",
    "\n",
    "\n",
    "def get_speaker_embeddings(audio_path, segments):\n",
    "    \"\"\"Compute one embedding per unique speaker from their combined segments.\"\"\"\n",
    "    audio = AudioSegment.from_wav(str(audio_path))\n",
    "    speaker_audio = {}\n",
    "    for seg in segments:\n",
    "        chunk = audio[seg['start_ms']:seg['end_ms']]\n",
    "        spk = seg['speaker']\n",
    "        speaker_audio[spk] = speaker_audio.get(spk, AudioSegment.empty()) + chunk\n",
    "\n",
    "    embeddings = {}\n",
    "    for spk, combined in speaker_audio.items():\n",
    "        tmp_path = f'/content/tmp_{spk}.wav'\n",
    "        combined.export(tmp_path, format='wav')\n",
    "        embeddings[spk] = get_embedding(tmp_path)\n",
    "        os.remove(tmp_path)\n",
    "    return embeddings\n",
    "\n",
    "\n",
    "def find_target(speaker_embeddings):\n",
    "    \"\"\"Return (best_speaker_id, score) against reference.\"\"\"\n",
    "    best, best_score = None, -1.0\n",
    "    for spk, emb in speaker_embeddings.items():\n",
    "        score = cosine_sim(emb, reference_embedding)\n",
    "        print(f'   {spk}: {score:.3f}')\n",
    "        if score > best_score:\n",
    "            best, best_score = spk, score\n",
    "    return best, best_score\n",
    "\n",
    "\n",
    "def export_segments(audio_path, segments, target_speaker, output_dir):\n",
    "    \"\"\"Save individual WAV clips for the target speaker.\"\"\"\n",
    "    audio = AudioSegment.from_wav(str(audio_path))\n",
    "    video_name = Path(audio_path).stem[:60]  # cap filename length\n",
    "    out_folder = Path(output_dir) / video_name\n",
    "    out_folder.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "    target_segs = [s for s in segments if s['speaker'] == target_speaker]\n",
    "    saved = []\n",
    "    for i, seg in enumerate(target_segs):\n",
    "        chunk = audio[seg['start_ms']:seg['end_ms']]\n",
    "        start_s = seg['start_ms'] / 1000\n",
    "        end_s   = seg['end_ms']   / 1000\n",
    "        fname = out_folder / f'seg_{i+1:04d}_{start_s:.1f}s-{end_s:.1f}s.wav'\n",
    "        chunk.export(str(fname), format='wav')\n",
    "        saved.append(str(fname))\n",
    "    return saved, str(out_folder)\n",
    "\n",
    "print('✅ Helper functions ready')"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ── CELL 8: RUN — processes all URLs ──────────────────────────────────────────\n",
    "import gc\n",
    "\n",
    "all_results = []\n",
    "\n",
    "for idx, url in enumerate(YOUTUBE_URLS):\n",
    "    print(f'\\n{\"=\"*60}')\n",
    "    print(f'[{idx+1}/{len(YOUTUBE_URLS)}] {url}')\n",
    "    print('='*60)\n",
    "\n",
    "    try:\n",
    "        # 1. Download\n",
    "        print('⬇️  Downloading audio...')\n",
    "        audio_path = download_audio(url, TMP_DIR)\n",
    "        print(f'   → {audio_path.name}')\n",
    "\n",
    "        # 2. Diarize\n",
    "        print('🎙️  Diarizing speakers...')\n",
    "        segments = diarize(audio_path)\n",
    "        unique_speakers = set(s['speaker'] for s in segments)\n",
    "        print(f'   Found {len(segments)} segments, {len(unique_speakers)} speakers')\n",
    "\n",
    "        # 3. Match voice\n",
    "        print('🔍 Matching against reference voice...')\n",
    "        speaker_embs = get_speaker_embeddings(audio_path, segments)\n",
    "        target, score = find_target(speaker_embs)\n",
    "\n",
    "        if score < SIMILARITY_THRESHOLD:\n",
    "            print(f'⚠️  Best match score {score:.3f} < threshold {SIMILARITY_THRESHOLD}. Skipping.')\n",
    "            print('   Tip: lower SIMILARITY_THRESHOLD in Cell 4 if the speaker is present.')\n",
    "            all_results.append({'url': url, 'status': 'skipped', 'score': score})\n",
    "            continue\n",
    "\n",
    "        print(f'✅ Target speaker: {target} (score={score:.3f})')\n",
    "\n",
    "        # 4. Export\n",
    "        print('✂️  Exporting clips...')\n",
    "        saved, folder = export_segments(audio_path, segments, target, OUTPUT_DIR)\n",
    "        print(f'   Saved {len(saved)} clips → {folder}')\n",
    "        all_results.append({'url': url, 'status': 'done', 'clips': len(saved), 'folder': folder, 'score': score})\n",
    "\n",
    "        # Cleanup tmp audio to save disk space\n",
    "        os.remove(audio_path)\n",
    "\n",
    "    except Exception as e:\n",
    "        print(f'❌ Error: {e}')\n",
    "        all_results.append({'url': url, 'status': 'error', 'error': str(e)})\n",
    "\n",
    "    # Free GPU memory between videos\n",
    "    gc.collect()\n",
    "    torch.cuda.empty_cache()\n",
    "\n",
    "# ── Summary ──\n",
    "print(f'\\n{\"=\"*60}')\n",
    "print('📊 SUMMARY')\n",
    "print('='*60)\n",
    "for r in all_results:\n",
    "    status_icon = {'done': '✅', 'skipped': '⚠️', 'error': '❌'}.get(r['status'], '?')\n",
    "    if r['status'] == 'done':\n",
    "        print(f\"{status_icon} {r['url'][:60]}  →  {r['clips']} clips (score={r['score']:.3f})\")\n",
    "    else:\n",
    "        print(f\"{status_icon} {r['url'][:60]}  →  {r['status']}\")"
   ],
   "execution_count": null,
   "outputs": []
  },
